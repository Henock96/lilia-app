<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements Debug + Profile. Sans `aps-environment`, iOS refuse
	     l'enregistrement APNS : `getAPNSToken()` reste nul, `getToken()` lève
	     `apns-token-not-set` et AUCUN push n'arrive — y compris sur un iPhone
	     physique. La config Release a son propre fichier
	     (RunnerRelease.entitlements). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
